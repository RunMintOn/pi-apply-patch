{
  "name": "@runminton/pi-apply-patch",
  "version": "1.0.0",
  "description": "Codex Rust apply_patch engine for Pi, with confirmed-change recovery and actual diffs",
  "license": "(MIT AND Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RunMintOn/pi-apply-patch.git"
  },
  "keywords": ["pi-package", "pi", "apply-patch", "codex", "openai"],
  "os": ["darwin"],
  "cpu": ["arm64"],
  "files": [
    "index.ts",
    "diff-view.ts",
    "bin/pi-apply-patch",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "backend/LICENSE",
    "backend/NOTICE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/check-package.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test test/*.test.mjs",
    "test:live": "node test/live.mjs"
  },
  "pi": {
    "extensions": ["./index.ts"]
  }
}
